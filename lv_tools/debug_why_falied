from omni.replicator.core import WriterRegistry
from omni.replicator.core.writers import Writer
from omni.replicator.core.writers_default import BasicWriter
from isaacsim.replicator.writers import PoseWriter

from pprint import pprint

class BasicDataCollector(BasicWriter):
    def write(self, data: dict):
        # print(f'{"B"*20}')
        # pprint(data)
        return data
class PoseDataCollector(PoseWriter):
    def write(self,data:dict):
        # print(f'{"P"*20}')
        # pprint(data)
        return data

class LMDBWriter(Writer):
    def __init__(self,basic_data_collector:BasicDataCollector,pose_data_collector:PoseDataCollector):
        self.basic_data_collector = basic_data_collector
        self.pose_data_collector = pose_data_collector
        self.annotators = self.basic_data_collector.get_annotators()+self.pose_data_collector.get_annotators()


    def write(self,data:dict):
        print(f'{"P"*20}')
        pprint(data)
        return data


